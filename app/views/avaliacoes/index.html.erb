<div class="min-h-screen bg-gray-50">
  <div class="max-w-2xl mx-auto px-4 py-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900"><%= t("avaliacoes.title") %></h1>
      <div class="flex items-center gap-2">
        <%= link_to calendar_path, class: "text-blue-600 hover:text-blue-800 text-sm" do %>
          <%= t("avaliacoes.back") %>
        <% end %>
      </div>
    </div>

    <% if @error %>
      <div class="bg-red-50 text-red-800 px-4 py-3 rounded-lg text-sm mb-4">
        <%= @error %>
      </div>
    <% end %>

    <% if @school_year %>
      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="text-sm text-gray-500"><%= t("avaliacoes.school_year") %></span>
          <span class="text-sm font-semibold text-gray-700 ml-1"><%= @school_year.label %></span>
        </div>
        <%= button_to refresh_avaliacoes_path,
            method: :post,
            class: "px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors text-xs font-medium" do %>
          <%= t("avaliacoes.refresh") %>
        <% end %>
      </div>

      <% tipos = @school_year.evaluation_types.order(:start_date) %>
      <% disciplinas = @school_year.subjects.order(:ordem) %>
      <% avaliacoes = @school_year.evaluations.where(final: false) %>

      <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <table class="w-full text-xs">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="text-left px-2 py-1.5 font-semibold text-gray-700 whitespace-nowrap"><%= t("avaliacoes.subject") %></th>
              <% tipos.each do |tipo| %>
                <th class="text-center px-1.5 py-1.5 font-semibold text-gray-700 whitespace-nowrap" title="<%= tipo.descricao %>"><%= tipo.sigla %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% disciplinas.each do |disciplina| %>
              <tr class="border-b border-gray-100">
                <td class="px-2 py-1.5 text-gray-800 font-medium whitespace-nowrap">
                  <span class="sm:hidden"><%= disciplina.sigla %></span>
                  <span class="hidden sm:inline"><%= disciplina.descricao %></span>
                </td>
                <% tipos.each do |tipo| %>
                  <% aval = avaliacoes.find { |a| a.subject_id == disciplina.id && a.evaluation_type_id == tipo.id } %>
                  <td class="text-center px-1.5 py-1.5">
                    <% if aval && aval.avaliacao.present? %>
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded font-medium
                        <%= grade_color(aval.avaliacao) %>">
                        <%= aval.avaliacao %>
                      </span>
                    <% elsif aval && aval.alinea.present? %>
                      <span class="text-gray-400"><%= aval.alineadescricao %></span>
                    <% else %>
                      <span class="text-gray-300">—</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @school_year.final_evaluations.any? %>
        <div class="mt-6 bg-white rounded-xl shadow-sm p-4">
          <h2 class="font-semibold text-gray-800 mb-2"><%= t("avaliacoes.final_evaluation") %></h2>
          <% @school_year.final_evaluations.each do |final| %>
            <div class="text-sm text-gray-600 space-y-1">
              <% if final.descricaorfa.present? %>
                <p><span class="font-medium"><%= t("avaliacoes.rfa") %>:</span> <%= final.descricaorfa %>
                  <% if final.positivorfa %><span class="text-green-600 ml-1"><%= t("avaliacoes.positive") %></span><% end %>
                </p>
              <% end %>
              <% if final.descricaorfc.present? %>
                <p><span class="font-medium"><%= t("avaliacoes.rfc") %>:</span> <%= final.descricaorfc %>
                  <% if final.positivorfc %><span class="text-green-600 ml-1"><%= t("avaliacoes.positive") %></span><% end %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500 mb-4"><%= t("avaliacoes.no_data") %></p>
        <%= button_to refresh_avaliacoes_path,
            method: :post,
            class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium" do %>
          <%= t("avaliacoes.fetch_now") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
